{
  "name": "@nuwax-ai/agent-kit",
  "version": "0.1.1",
  "description": "Shared agent/ACP logic for nuwa-cli and nuwaclaw (engine resolution, agent install).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@nuwax-ai/nuwax-codex-acp-ts": "^1.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
