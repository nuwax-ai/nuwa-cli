{
  "name": "@nuwax-ai/nuwa-cli",
  "version": "0.1.0-beta.53",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/lanproxy"
  ],
  "description": "Headless multi-engine agent CLI with managed Gateway, Console, ACP engines, and remote session routing",
  "type": "module",
  "bin": {
    "nuwa-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:tsc": "tsc",
    "dev:build": "node scripts/build.mjs",
    "dev:cli": "node dist/cli.js",
    "dev:doctor": "node dist/cli.js doctor",
    "dev:chat": "node dist/cli.js chat",
    "dev:chat:codex": "node dist/cli.js chat --engine codex",
    "dev:sessions": "node dist/cli.js sessions",
    "dev:sessions:summary": "node dist/cli.js sessions summary",
    "dev:gateway": "node dist/cli.js gateway",
    "dev:serve": "node dist/cli.js serve --port 60016",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "node scripts/assert-beta-release.mjs && npm run build",
    "release:beta": "node scripts/release-beta.mjs",
    "release:beta:dry-run": "node scripts/release-beta.mjs --dry-run",
    "release:lanproxy": "node scripts/release-lanproxy.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@anthropic-ai/sdk": "^0.111.0",
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nuwax-ai/agent-kit": "^0.3.0",
    "@nuwax-ai/lanproxy": "^1.0.0",
    "@nuwax-ai/mcp-proxy-ts": "^1.5.4",
    "@nuwax-ai/nuwax-codex-acp-ts": "^1.2.4",
    "claude-code-acp-ts": "^0.57.0",
    "commander": "^15.0.0",
    "node-machine-id": "^1.1.12",
    "nuwax-file-server": "^1.3.4",
    "picocolors": "^1.1.1",
    "which": "^5.0.0",
    "write-file-atomic": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/which": "^3.0.4",
    "@types/write-file-atomic": "^4.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwax-ai/nuwa-cli.git"
  },
  "homepage": "https://github.com/nuwax-ai/nuwa-cli#readme",
  "bugs": {
    "url": "https://github.com/nuwax-ai/nuwa-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
